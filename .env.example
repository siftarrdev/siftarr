# System
TZ=UTC
PUID=1000
PGID=1000

# Overseerr
OVERSEERR_URL=http://overseerr:5055
OVERSEERR_API_KEY=your_api_key_here

# Prowlarr
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_api_key_here

# qBittorrent
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_API_KEY=your_api_key_here

# Release preferences and user-confirmed recovery. See docs/release-selection.md.
# Penalties subtract points; archives are not hard-blocked.
# RELEASE_FILE_COUNT_BONUS=5
# RELEASE_HIGH_FILE_COUNT_PENALTY=10
# RELEASE_ARCHIVE_PENALTY=100
# RELEASE_RAR_TITLE_PENALTY=50
# RELEASE_LOW_SEED_PENALTY=40
# RELEASE_MARGINAL_SEED_PENALTY=10
# TV_EPISODE_FALLBACK_MAX_SIZE_GB=3
# RELEASE_OBSERVATION_MAX_AGE_HOURS=24
# DOWNLOAD_STALL_WARNING_HOURS=6
# DOWNLOAD_STALL_RECOVERY_HOURS=24
# RELEASE_FAILURE_COOLDOWN_HOURS=24
# TRUSTED_TV_TITLE_ALIASES={}

# Session secret for Plex SSO. Set this to a stable random value so browser
# sessions survive container/app restarts.
# SECRET_KEY=

# API key for programmatic/webhook access (auto-generated on first startup if unset)
# SIFTARR_API_KEY=

# Plex
PLEX_URL=http://plex:32400
# Plex token is managed by Plex SSO. The first Plex login claims this Siftarr
# instance as the sole admin; later non-admin Plex logins are denied.
# PLEX_TOKEN=
